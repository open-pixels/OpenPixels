{
  "name": "openpixels-web",
  "version": "0.1.0",
  "private": true,
  "description": "OpenPixels: free image upscaling, restoration and background removal, entirely in the browser.",
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:wasm": "bash scripts/build-wasm.sh",
    "dev": "vite",
    "preview": "vite preview --port 8083",
    "test": "vitest run",
    "smoke": "node e2e/smoke.mjs",
    "features": "node e2e/features.mjs",
    "verify:prod": "node e2e/verify-prod.mjs",
    "test:account": "node e2e/account.mjs",
    "serve": "bash scripts/serve.sh",
    "capture": "node e2e/capture.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "playwright": "^1.48.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
